# the URL where the CouchDB instance can be accessed
DATABASE_URL=http://aam.localhost/db/couchdb
# the name of a user that is a `member` of all databases inside the CouchDB instance.
# In case the proxy is also used to create new entries in the `_users` database,
# then this user needs to be `admin` in this database.
DATABASE_USER=admin
# the password for DATABASE_USER
DATABASE_PASSWORD=docker
# the database name where the permissions definition document is stored
PERMISSION_DB=app

# (optional) per-request timeout in ms for requests to CouchDB (default 60000).
# Requests that exceed this are aborted instead of hanging forever.
# Must stay above ~55000 because the internal changes feed uses 50s longpoll requests.
# DATABASE_TIMEOUT_MS=60000
# (optional) maximum number of parallel keep-alive connections to CouchDB (default 50).
# Bounds the connection load that request bursts (e.g. many syncing clients) can place on CouchDB.
# DATABASE_MAX_SOCKETS=50

# Keycloak admin API configuration - required. Besides resolving user roles via the
# Keycloak Admin API for the /api/v1/permissions/check endpoint, it is also used to
# verify bearer JWTs against this realm's JWKS
# (KEYCLOAK_ADMIN_BASE_URL/realms/KEYCLOAK_REALM/protocol/openid-connect/certs),
# so the process fails to start without KEYCLOAK_ADMIN_BASE_URL / KEYCLOAK_REALM.
KEYCLOAK_ADMIN_BASE_URL=https://keycloak.localhost
# the Keycloak realm name
KEYCLOAK_REALM=dummy-realm
# (optional, required together with KEYCLOAK_ADMIN_BASE_URL) only needed to enable
# the /api/v1/permissions/check endpoint - the Keycloak client ID used to
# authenticate against the Keycloak Admin API
KEYCLOAK_ADMIN_CLIENT_ID=aam-backend
# (optional, required together with KEYCLOAK_ADMIN_CLIENT_ID) the client secret for
# KEYCLOAK_ADMIN_CLIENT_ID
KEYCLOAK_ADMIN_CLIENT_SECRET=

# When KEYCLOAK_ADMIN_BASE_URL uses https:// with a self-signed CA (e.g. local Caddy),
# set the NODE_EXTRA_CA_CERTS shell env var *before* starting Node:
#   export NODE_EXTRA_CA_CERTS=/path/to/aam-services/docs/developer/container-data/caddy-authorities/root.crt

# secret to create JWT tokens. They are used in the JWT auth which works similar to CouchDB's `POST /_session` endpoint. This should be changed to prevent others to create fake JWT tokens.
JWT_SECRET=someJwtSecret

# (optional) comma-separated list of document ID prefixes to exclude from replication.
# Defaults to "_design/" if unset. Override to filter additional doc types.
# REPLICATION_IGNORED_PREFIXES=_design/

# (optional, default false) enables recording a tamper-resistant audit/changelog
# entry for every entity write. When disabled the feature is a complete no-op.
# AUDIT_ENABLED=true

# (optional) the [Sentry DSN](https://docs.sentry.io/product/sentry-basics/dsn-explainer/). If defined, error messages are sent to the sentry.io application monitoring & logging service.
SENTRY_DSN=
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=
SENTRY_INSTANCE_NAME=
# (optional) decimal between 0.0 and 1.0 for transaction tracing sample rate
# lower this to reduce Sentry performance monitoring volume/cost (default: 0.02)
SENTRY_TRACES_SAMPLE_RATE=0.02
